# Copy this file to .env and fill in real values. .env is gitignored.
#
# Parsing notes — .env is read with parse_ini_string(), so:
#   - Lines starting with # are stripped before parsing (plain INI only knows ;).
#   - Wrap a value in double quotes if it contains  # ; = " '  or spaces.
#     A password like  p@ss#word  MUST be written as  DB_PASSWORD="p@ss#word"
#     or everything from # onward is silently discarded.
#   - yes/no/true/false/null/on/off are INI reserved words and become booleans.
#     Quote them if you mean the literal string.

APP_DEBUG=false

# Never use the MySQL root account for an application, and never with an empty
# password. Create a dedicated user with only the privileges this app needs:
#
#   CREATE USER 'route_php'@'localhost' IDENTIFIED BY 'a-long-random-password';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON temp.* TO 'route_php'@'localhost';
#   FLUSH PRIVILEGES;
#
# Note: MySQL treats 'localhost' and '127.0.0.1' as different hosts. 'localhost'
# connects over a socket/named pipe, '127.0.0.1' over TCP, and the grant tables
# match on that host string — a user granted on 'localhost' will be refused on
# '127.0.0.1'. Keep this value and the GRANT in agreement.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=temp
DB_USERNAME=route_php
DB_PASSWORD="change-me"
